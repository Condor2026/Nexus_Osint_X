# ═══════════════════════════════════════════════════════════════════════
# Nexus_Osint_X · Command Center v3.1 — plantilla de configuración
# ───────────────────────────────────────────────────────────────────────
# 1) cp .env.example .env
# 2) Rellena al menos ADMIN_PASSWORD y JWT_SECRET
# 3) chmod 600 .env     (en Linux/macOS/Termux: el archivo guarda claves)
#
# Todas las claves son OPCIONALES: sin ellas, la fuente correspondiente
# devuelve 0 eventos y el resto del sistema sigue funcionando.
# En la pestaña «🩺 Fuentes» se marca con 🔑 la que necesita clave.
# ═══════════════════════════════════════════════════════════════════════

# ── Autenticación / servidor ───────────────────────────────────────────
# Cámbiala. Con la de por defecto (admin123) solo se entra desde 127.0.0.1
# y sin cabeceras de proxy (X-Forwarded-For, X-Real-IP, Forwarded).
ADMIN_USER=admin        (sostituir)
ADMIN_PASSWORD=admin123 (sostituir)

# Firma de los JWT. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si lo dejas vacío, NEXUS genera uno y lo guarda en .nexus_jwt_secret (0600)
# para que las sesiones sobrevivan a los reinicios.
JWT_SECRET=

# Escucha. Por defecto loopback (seguro). 0.0.0.0 expone el panel a cualquiera
# que llegue a la máquina: si lo usas, pon delante Nginx/Caddy con TLS,
# una VPN o un firewall. Y define NEXUS_LOCAL_NOAUTH=0.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# 1 = el dashboard no pide login desde 127.0.0.1 sin proxy
#     (valida Host, Origin y Sec-Fetch-Site contra DNS-rebinding).
# 0 = exige login siempre (recomendado si lo publicas).
NEXUS_LOCAL_NOAUTH=1

# Contacto que aparece en el User-Agent fijo de Wikipedia/Wikimedia
# (su política exige un UA descriptivo; con uno de navegador dan 403).
NEXUS_CONTACT=nexus-osint@localhost

# ── Barridos ───────────────────────────────────────────────────────────
# Intervalo del barrido COMPLETO en minutos (0 = manual).
# Valores válidos en la barra: 0, 3, 5, 15, 60, 1440. Se puede cambiar
# también desde la interfaz (se guarda en la BD, tabla app_kv).
NEXUS_SWEEP_MINUTES=15

# Carril rápido de prensa (solo noticias, no toca tendencias ni anomalías).
NEXUS_NEWS_MINUTES=4

# Carril rápido del detector de denuncias (Telegram + RSS + monitor DDoS).
NEXUS_GROUPS_MINUTES=5

# Fuentes simultáneas del barrido completo (antes se lanzaban ~110 de golpe).
NEXUS_SOURCE_CONCURRENCY=32

# ── Retención y datos ──────────────────────────────────────────────────
# Días que se guardan eventos, correlaciones, anomalías y auditoría (0 = nunca).
NEXUS_RETENTION_DAYS=120

# Qué intel de cibercrimen NO se borra nunca (ni por retención ni por «Eliminar datos»):
#   important = cibercrimen y ransomware (todo) + ataques/malware/exploits/phishing/DDoS
#               de severidad ALTA/CRÍTICA o reivindicados por un grupo  (por defecto)
#   all       = todo el dominio cibernético
#   off       = no protege nada (se puede purgar todo)
NEXUS_KEEP_CYBER=important

# Días que se guarda una IP de grupo sin volver a verla (0 = nunca caduca).
NEXUS_GROUP_IP_KEEP_DAYS=30
# Máx. IPs por grupo (se quedan las más recientes).
NEXUS_GROUP_IP_CAP=1500
# «Fresca» = vista EN VIVO en las últimas N horas.
NEXUS_GROUP_FRESH_HOURS=72

# Carpeta intel/ de Andrómeda con ficheros grupo_<slug>.txt (opcional).
# Si se indica, se leen sus IPs y se atribuyen al grupo del nombre del fichero.
NEXUS_GROUP_IP_DIR=

# 1 = añade también las IPs fijas de Andrómeda (GROUP_IP_SEEDS). Apagado por
# defecto: no son frescas y pueden estar obsoletas.
NEXUS_GROUP_SEEDS=0

# ── Detector de denuncias (Telegram) ───────────────────────────────────
# 1 = desactiva el escaneo de canales públicos de Telegram.
NEXUS_TG_OFF=
# Intervalo mínimo por canal, en minutos.
NEXUS_TG_MINUTES=10
# Edad máxima de un mensaje, en horas.
NEXUS_TG_MAX_AGE_H=72
# Canales por tanda (rotan; ~600 canales ≈ 10 pasadas). «Escanear ahora» sube
# la tanda temporalmente a 150.
NEXUS_TG_PER_RUN=60
# Canales extra separados por comas (se añaden a los ~600 de Andrómeda).
NEXUS_TG_CHANNELS=

# ── Monitor DDoS ───────────────────────────────────────────────────────
# Cada cuánto corre el monitor de listas vivas, en minutos.
NEXUS_DDOS_MON_MINUTES=15
# Máx. IPs coincidentes que geolocaliza por pasada.
NEXUS_DDOS_MON_GEO=600

# ── Mapa ───────────────────────────────────────────────────────────────
# Máx. puntos en el mapa (prioriza severidad y relevancia).
NEXUS_MAP_POINTS=1500
# URL de deck.gl (CDN por defecto; cámbiala para servirlo localmente).
NEXUS_DECK_URL=
# URL del GeoJSON de países (Natural Earth 110m por defecto).
NEXUS_LAND_URL=
# Destino por defecto de los arcos ILUSTRATIVOS (el selector «Solo flujos
# reales» es el de por defecto; los flujos reales no usan esto).
NEXUS_ARC_TARGET=38.9072,-77.0369

# ── Fuentes que requieren clave (todas opcionales) ─────────────────────
# abuse.ch (URLhaus, ThreatFox, MalwareBazaar) — gratis en https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Cloudflare Radar (pares reales origen→objetivo de DDoS) — permiso Radar
# en https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# OpenSky Network (vuelos) — https://opensky-network.org/
OPENSKY_USER=
OPENSKY_PASS=

# FRED (St. Louis Fed) — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# EIA (energía) — https://www.eia.gov/opendata/
EIA_API_KEY=

# ACLED (conflictos) — https://developer.acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=

# AISStream (marítimo) — https://aisstream.io/
AISSTREAM_API_KEY=

# ADS-B Exchange (vuelos militares) — https://www.adsbexchange.com/
ADSB_API_KEY=

# ReliefWeb (OCHA) — https://apidoc.reliefweb.int/ (appname aprobado)
RELIEFWEB_APPNAME=

# OpenSanctions — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Ransomware.live — https://www.ransomware.live/
RANSOMWARE_LIVE_KEY=

# Reddit (opcional, no usado por los colectores actuales)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Bot de Telegram (⚠️ SIN PROBAR) ────────────────────────────────────
# El código está escrito, pero no se ha ejecutado de principio a fin.
# No lo uses como canal de alertas en producción. Si no defines
# TELEGRAM_BOT_TOKEN, el bot no arranca y el resto sigue igual.
#   TELEGRAM_BOT_TOKEN: @BotFather
#   TELEGRAM_CHAT_ID:   @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM opcional (resumen ejecutivo en la pestaña IA) ──────────────────
# Sin clave, la pestaña devuelve «Análisis LLM no disponible».
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
