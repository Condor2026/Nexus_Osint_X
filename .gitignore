# ═══════════════════════════════════════════════════════════════════════
# Nexus_Osint_X · Command Center v3.1 — .gitignore
# ───────────────────────────────────────────────────────────────────────
# Regla: NUNCA subir secretos, bases de datos, cachés ni datos personales.
# ═══════════════════════════════════════════════════════════════════════

# ── Secretos y configuración local ─────────────────────────────────────
.env
.env.*
!.env.example
.nexus_jwt_secret

# ── Base de datos y estado de SQLite ───────────────────────────────────
nexus.db
nexus.db-wal
nexus.db-shm
nexus.db-journal
nexus.db.lock
*.sqlite
*.sqlite3

# ── Cachés y runtime ───────────────────────────────────────────────────
.cache/
*.log
nexus.log
*.pid
*.tmp
*.temp

# ── Geolocalización (MaxMind exige que no se redistribuya) ─────────────
GeoLite2-City.mmdb
GeoLite2-Country.mmdb
GeoLite2-ASN.mmdb

# ── Intel / datos que no deben publicarse ──────────────────────────────
# (carpeta de Andrómeda con grupo_<slug>.txt, listas locales, etc.)
intel/
feeds/
lists/
*.txt
!requirements.txt
!LICENSE
!README.md
!CONTRIBUTING.md
!SECURITY.md
!.gitignore
!.env.example

# ── Exportaciones y paquetes generados ─────────────────────────────────
exports/
*.csv
*.json
*.ndjson
*.geojson
*.kml
*.xlsx
*.zip
!package.json
!package-lock.json
!tsconfig.json

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Entornos virtuales ─────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.conda/
.python-version

# ── Herramientas de testing / cobertura ────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ── IDEs y editores ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-workspace
*.sublime-project

# ── Jupyter (por si alguien analiza los datos) ─────────────────────────
.ipynb_checkpoints/

# ── Terraform / Docker / despliegue local ──────────────────────────────
terraform.tfstate*
docker-compose.override.yml
Dockerfile.local

# ── Datos temporales del sistema ───────────────────────────────────────
*.bak
*.orig
*.rej
*.patch.tmp
*~
